                                    <TextBlock Text="{Binding DisplayName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ForegroundBrushKey}" Value="ErrorBrush">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ForegroundBrushKey}" Value="TextDisabledBrush">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

                    <!-- Task details grid -->
                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceBrush}"
                                Padding="8,4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding ScheduledTaskDetailHeader}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <DataGrid ItemsSource="{Binding ScheduledTaskDetails}"
                                  AutomationProperties.Name="Task properties"
                                  SelectedItem="{Binding SelectedScheduledTaskDetail}"
                                  AlternationCount="2"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Property" Width="200" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Column1}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Value" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock helpers:RichText.FormattedText="{Binding Column2}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>

                <!-- ═══ Certificate Stores View ═══ -->
                <Grid Visibility="{Binding CurrentMode, Converter={StaticResource ModeToVis}, ConverterParameter=CertificateStores}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="150" />
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Stores/certificates tree -->
                    <DockPanel Grid.Column="0">
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceBrush}"
                                Padding="8,4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding CertStoresTreeHeader}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <TreeView ItemsSource="{Binding CertStoreNodes}"
                                  AutomationProperties.Name="Certificate stores"
                                  SelectedItemChanged="CertStoresTree_SelectedItemChanged"
                                  Background="{DynamicResource BackgroundBrush}"
                                  BorderThickness="0">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.Resources>
                                <HierarchicalDataTemplate DataType="{x:Type vm:AnalyzeViewModel+ScheduledTaskTreeNode}"
                                                          ItemsSource="{Binding Children}">
                                    <TextBlock Text="{Binding DisplayName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ForegroundBrushKey}" Value="ErrorBrush">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ForegroundBrushKey}" Value="TextDisabledBrush">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </HierarchicalDataTemplate>
                            </TreeView.Resources>
                        </TreeView>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

                    <!-- Certificate details grid -->
                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource SurfaceBrush}"
                                Padding="8,4"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding CertStoreDetailHeader}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Border>
                        <DataGrid ItemsSource="{Binding CertificateDetails}"
                                  AutomationProperties.Name="Certificate properties"
                                  SelectedItem="{Binding SelectedCertificateDetail}"
                                  AlternationCount="2"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Property" Width="200" MinWidth="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Column1}"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Value" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock helpers:RichText.FormattedText="{Binding Column2}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="8,2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>

                <!-- ═══ Group Policy View (GPResult-style scrollable document) ═══ -->
                <DockPanel Visibility="{Binding CurrentMode, Converter={StaticResource ModeToVis}, ConverterParameter=GroupPolicy}">
                    <!-- Top header bar with search -->
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SurfaceBrush}"
                            Padding="8,4"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="12,0,0,0">
                                <!-- Info icon with scope popup -->
                                <Button x:Name="GpInfoButton"
                                        AutomationProperties.Name="Policy scope info"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" Padding="4,2" Margin="0,0,8,0"
                                        ToolTip="Policy scope info"
                                        Click="GpInfoButton_Click">
                                    <Grid Width="18" Height="18">
                                        <Ellipse Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.2" Fill="Transparent" />
                                        <TextBlock Text="i" FontSize="11" FontStyle="Italic" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,-1,0,0" />
                                    </Grid>
                                </Button>
                                <Popup x:Name="GpInfoPopup" PlacementTarget="{Binding ElementName=GpInfoButton}"
                                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Padding="14,10" Margin="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3" />
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Policy Scope" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       Margin="0,0,0,8" />
                                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                                       Margin="0,0,0,6">
                                                Shows registry-based policies only:
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                       Margin="12,0,0,2" Text="&#x2022;  Administrative Templates" />
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                       Margin="12,0,0,2" Text="&#x2022;  Security Options (with registry paths)" />
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                       Margin="12,0,0,8" Text="&#x2022;  Extra Registry Settings" />
                                            <TextBlock Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"
                                                       Margin="0,0,0,6">
                                                Does not include:
                                            </TextBlock>
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                       Margin="12,0,0,2" Text="&#x2022;  Password / Account Lockout policies" />
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                       Margin="12,0,0,2" Text="&#x2022;  Audit Configuration" />
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                       Margin="12,0,0,2" Text="&#x2022;  User Rights Assignment" />
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                       Margin="12,0,0,2" Text="&#x2022;  Scripts (Startup / Shutdown)" />
                                            <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                                       Margin="12,0,0,0" Text="&#x2022;  User-scoped (HKCU) policies" />
                                        </StackPanel>
                                    </Border>
                                </Popup>

                                <TextBlock Text="Search:" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="11" Margin="0,0,6,0" />
                                <TextBox Text="{Binding GpSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                                         AutomationProperties.Name="Search policies"
                                         Width="200" Padding="6,3"
                                         VerticalAlignment="Center"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Background="{DynamicResource BackgroundBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding GroupPolicyHeader}"
                                       FontSize="11" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DockPanel>
                    </Border>

                    <!-- Scrollable document of section headers + policy rows -->
                    <ListBox ItemsSource="{Binding GroupPolicyDocRows}"
                             AutomationProperties.Name="Group Policy settings"
                             SelectedItem="{Binding SelectedGroupPolicyRow}"
                             Background="{DynamicResource BackgroundBrush}"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.Resources>
                            <!-- Section header template -->
                            <DataTemplate x:Key="SectionHeaderTemplate">
                                <Border Background="{DynamicResource SurfaceLightBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0" Margin="0,8,0,0">
                                    <DockPanel>
                                        <!-- Accent left-edge bar -->
                                        <Border DockPanel.Dock="Left"
                                                Width="4"
                                                Background="{DynamicResource AccentBrush}" />
                                        <TextBlock DockPanel.Dock="Right"
                                                   Margin="8,6"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="({0})">
                                                    <Binding Path="SettingCount" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock Text="{Binding CategoryPath}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="8,6"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>

                            <!-- Policy row template -->
                            <DataTemplate x:Key="PolicyRowTemplate">
                                <Grid Margin="12,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding PolicyName}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="8,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SettingValue}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="8,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>

                            <!-- List child row template (indented under enabledList parent) -->
                            <DataTemplate x:Key="ListChildRowTemplate">
                                <Grid Margin="36,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding PolicyName}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="8,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SettingValue}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="8,3">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ListBox.Resources>

                        <ListBox.ItemTemplateSelector>
                            <helpers:GpDocumentTemplateSelector
                                SectionHeaderTemplate="{StaticResource SectionHeaderTemplate}"
                                PolicyRowTemplate="{StaticResource PolicyRowTemplate}"
                                ListChildRowTemplate="{StaticResource ListChildRowTemplate}" />
                        </ListBox.ItemTemplateSelector>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd"
                                                    Background="Transparent"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SelectionActiveBrush}" />
                                                </Trigger>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" Value="True" />
                                                        <Condition Property="IsSelected" Value="False" />
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource SurfaceHoverBrush}" />
                                                </MultiTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <!-- Make section header rows non-selectable -->
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSectionHeader}" Value="True">
                                        <Setter Property="IsHitTestVisible" Value="True" />
                                        <Setter Property="Focusable" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>

            </Grid>

            <!-- Detail pane splitter (hidden for DiskLayout — that view has its own Expander) -->
            <GridSplitter Grid.Row="3"
                          Height="3"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Visibility="{Binding CurrentMode, Converter={StaticResource ModeNotToVis}, ConverterParameter=DiskLayout}" />

            <!-- ═══ Detail Pane (hidden for DiskLayout) ═══ -->
            <Border Grid.Row="4"
                    Height="150"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,0"
                    Visibility="{Binding CurrentMode, Converter={StaticResource ModeNotToVis}, ConverterParameter=DiskLayout}">
                <DockPanel>
                    <!-- Registry path -->
                    <TextBox DockPanel.Dock="Top"
                             AutomationProperties.Name="Selected registry path"
                             Text="{Binding DetailRegistryPath, Mode=OneWay}"
                             IsReadOnly="True"
                             FontSize="11"
                             Background="{DynamicResource SurfaceLightBrush}"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"
                             BorderThickness="0,0,0,1"
                             Padding="8,4" />

                    <!-- Value detail -->
                    <TextBox Text="{Binding DetailValueText, Mode=OneWay}"
                             AutomationProperties.Name="Selected value details"
                             Style="{DynamicResource MonoTextBoxStyle}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
