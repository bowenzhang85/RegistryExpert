<Window x:Class="RegistryExpert.Wpf.Views.ReleaseNotesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Release Notes"
        Width="640" Height="720"
        MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Style="{DynamicResource ModernWindowStyle}"
        ShowInTaskbar="False"
        AutomationProperties.Name="Release notes">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Accent header band -->
        <Border Grid.Row="0"
                Background="{DynamicResource AccentBrush}"
                Padding="20,16">
            <DockPanel LastChildFill="True">
                <Image DockPanel.Dock="Left"
                       Source="pack://application:,,,/Assets/registry.png"
                       Width="40" Height="40"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       VerticalAlignment="Center"
                       Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Release Notes"
                               Foreground="White"
                               FontFamily="Segoe UI"
                               FontWeight="SemiBold"
                               FontSize="18" />
                    <TextBlock x:Name="HeaderSubtitle"
                               Foreground="#E6FFFFFF"
                               FontFamily="Segoe UI"
                               FontSize="12"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Body: markdown viewer OR empty state -->
        <Grid Grid.Row="1">
            <FlowDocumentScrollViewer x:Name="NotesViewer"
                                       Padding="24,18,24,18"
                                       Background="{DynamicResource BackgroundBrush}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalScrollBarVisibility="Auto"
                                       HorizontalScrollBarVisibility="Disabled"
                                       IsToolBarVisible="False"
                                       Zoom="100"
                                       MinZoom="80"
                                       MaxZoom="200" />

            <StackPanel x:Name="EmptyState"
                        Visibility="Collapsed"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="No release notes available for this version."
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,12" />
                <TextBlock HorizontalAlignment="Center" FontSize="13">
                    <Hyperlink x:Name="EmptyStateGitHubLink"
                               Click="ViewOnGitHubButton_Click"
                               Foreground="{DynamicResource AccentBrush}">
                        View on GitHub
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- Footer button bar -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource SurfaceBrush}"
                Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="GitHubButton"
                        Content="View on GitHub"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="14,6"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Click="ViewOnGitHubButton_Click"
                        AutomationProperties.Name="View release on GitHub" />
                <!-- Install-mode buttons (visibility toggled via the install-mode constructor) -->
                <Button x:Name="InstallButton"
                        Visibility="Collapsed"
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="14,6"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Click="InstallButton_Click"
                        AutomationProperties.Name="Install update now" />
                <Button x:Name="LaterButton"
                        Visibility="Collapsed"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="14,6"
                        FontSize="12"
                        Click="LaterButton_Click"
                        AutomationProperties.Name="Install later" />
                <!-- Default Close button (hidden in install mode) -->
                <Button x:Name="CloseButton"
                        Content="Close"
                        Style="{DynamicResource AccentButtonStyle}"
                        Padding="22,6"
                        FontSize="12"
                        Click="CloseButton_Click"
                        AutomationProperties.Name="Close release notes" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
